Recognize a copy of `@html-eslint/eslint-plugin` in the config.

The plugin finds `@html-eslint/eslint-plugin` among the config's plugins with `===`. We register a
copy of it when autofix of any of its rules is disabled, so it wasn't found. Then the JS inside
`<script>` tags was parsed with `@html-eslint/parser` instead of `espree`, and no JS rule reported
anything. Now a plugin with the same `meta.name` matches too.

The loop variable is renamed from `plugin` to `configPlugin`, as it hid the outer `plugin` variable,
which holds the package name compared with `meta.name`.

diff --git a/src/verifyWithFlatConfigPatch.js b/src/verifyWithFlatConfigPatch.js
index 9a6229ff83f4137c848805e3443b94a651170d67..3a7a6ba087bcb1b7dd714929151652210c01ecd3 100644
--- a/src/verifyWithFlatConfigPatch.js
+++ b/src/verifyWithFlatConfigPatch.js
@@ -138,8 +138,9 @@ function findExternalHtmlPluginName(config) {
     let parserModule = tryRequire(parser)
     if (config.languageOptions.parser === parserModule) {
       const pluginModule = tryRequire(plugin)
-      for (const [name, plugin] of Object.entries(config.plugins)) {
-        if (plugin === pluginModule) {
+      for (const [name, configPlugin] of Object.entries(config.plugins)) {
+        // Shareable configs may register a copy of the plugin, e.g. to wrap some of its rules
+        if (configPlugin === pluginModule || configPlugin.meta?.name === plugin) {
           return name
         }
       }
