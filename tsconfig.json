{
  // JSON modules imported from `src` and `scripts`: `composite` requires every input file to be listed
  "files": ["type-decls.d.ts", "package.json", ".prettierrc.json"],
  "include": ["src", "scripts", "eslint-local-rules"],
  "exclude": ["node_modules", "scripts/temp", ".claude/worktrees"],

  // Based on https://www.totaltypescript.com/tsconfig-cheat-sheet
  "compilerOptions": {
    "plugins": [
      {"name": "@effect/language-service"},
    ],

    /* Base Options: */
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    /* Strictness */
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,

    /* If NOT transpiling with TypeScript: */
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "emitDeclarationOnly": true,
    "outDir": "./temp/tsbuild/src",
    "tsBuildInfoFile": "./temp/tsbuild/src.tsbuildinfo",

    /* If transpiling with TypeScript: */
    // "moduleResolution": "NodeNext",
    // "module": "NodeNext",
    // "outDir": "dist",

    /* If you're building for a library: */
    "declaration": true,

    /* If you're building for a library in a monorepo: */
    // Referenced by `test/tsconfig.json` so that `tsc --build` type checks both projects at once
    "composite": true,
    // "sourceMap": true,
    // "declarationMap": true

    /* If your code runs in the DOM: */
    // "lib": ["es2022", "dom", "dom.iterable"],

    /* If your code doesn't run in the DOM: */
    // Source: https://github.com/tsconfig/bases/blob/12474cd696ec17c6ac4ccc19261860bf3c7fdc56/bases/node22.json
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
  },
}
