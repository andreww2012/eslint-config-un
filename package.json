{
  "name": "eslint-config-un",
  "version": "1.0.0-beta.3",
  "description": "A universal-ish ESLint config aiming to be reasonably strict and easily configurable.",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://github.com/andreww2012/eslint-config-un",
  "bugs": {
    "url": "https://github.com/andreww2012/eslint-config-un/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/eslint-config-un.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./snippets": {
      "types": "./dist/snippets.d.mts",
      "default": "./dist/snippets.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "deps"
  ],
  "scripts": {
    "u:after": "nr u:info && nr typegen",
    "u:info": "tsx scripts/updated-packages-info.ts",
    "u": "ncu && nr u:after",
    "u:m": "ncu -t minor && nr u:after",
    "deps:audit": "pnpm audit --audit-level high",
    "print-peer-deps": "tsx scripts/print-peer-deps.ts",
    "rules-finder": "tsx scripts/rules-finder.ts",
    "plugins-finder": "tsx scripts/plugins-finder.ts",
    "spellcheck": "cspell --no-progress --no-summary .",
    "format:check": "prettier --check '**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}' --log-level warn",
    "format:fix": "prettier --write '**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}' --log-level warn",
    "eslint:inspect": "eslint-config-inspector --open false",
    "lint:eslint": "eslint --cache --concurrency 2",
    "lint:eslint:fix": "nr lint:eslint --fix",
    "lint:types": "tsc --noEmit",
    "lint:types:go": "tsgo --noEmit",
    "lint:deps": "pnpm dedupe --check",
    "lint": "nr lint:types:go && nr format:check && nr lint:eslint",
    "lint:fix": "nr lint:eslint:fix && nr format:fix",
    "typegen": "tsx scripts/typegen.ts",
    "knip": "knip --no-progress",
    "build:code": "tsdown --clean",
    "build:code:test": "tsdown --out-dir temp/dist",
    "build": "nr typegen && nr build:code",
    "test:config": "tsx scripts/config-tester.ts",
    "test": "nr typegen && nr knip && nr spellcheck && nr test:config && nr lint && nr build:code:test",
    "lint:public-types": "attw --pack . --profile esm-only",
    "prepublishOnly": "nr test && nr build && nr lint:public-types",
    "change": "npx changeset add && nr spellcheck",
    "release": "changeset publish"
  },
  "overrides": {
    "eslint-plugin-jest": {
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    },
    "eslint-plugin-unused-imports": {
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    }
  },
