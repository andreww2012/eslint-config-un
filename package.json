{
  "name": "eslint-config-un",
  "version": "1.0.0-beta.11",
  "description": "A universal-ish ESLint config aiming to be reasonably strict and easily configurable.",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://github.com/andreww2012/eslint-config-un",
  "bugs": {
    "url": "https://github.com/andreww2012/eslint-config-un/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/eslint-config-un.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./snippets": {
      "types": "./dist/snippets.d.mts",
      "default": "./dist/snippets.mjs"
    },
    "./globs": {
      "types": "./dist/globs.d.mts",
      "default": "./dist/globs.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "deps"
  ],
  "scripts": {
    "contrib:add": "all-contributors add",
    "contrib:gen": "all-contributors generate",
    "u:after": "nr u:info && nr lint:eslint:fix package.json && nr typegen && nr u:test",
    "u:after:dev": "nr u:info && nr knip && nr spellcheck && nr u:test",
    "u:info": "node --import tsx/esm scripts/updated-packages-info.ts",
    "u:test": "nr lint:types:go && nr build:code:test --logLevel warn",
    "u": "ncu && nr u:after",
    "u:d": "ncu && nr u:after:dev",
    "u:m": "ncu -t minor && nr u:after",
    "u:pm": "ncu --dep packageManager",
    "deps:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:dedupe-check": "pnpm dedupe --check",
    "deps:peers-check": "pnpm peers check",
    "deps:check": "nr deps:peers-check && nr deps:audit",
    "deps:check:strict": "nr deps:dedupe-check && nr deps:check",
    "print-peer-deps": "node --import tsx/esm scripts/print-peer-deps.ts",
    "rules-finder": "node --import tsx/esm scripts/rules-finder.ts",
    "plugins:analyze": "node --import tsx/esm scripts/plugins-analyzer.ts",
    "plugins:find": "node --import tsx/esm scripts/plugins-finder.ts",
    "plugins:fetch": "node --import tsx/esm scripts/plugins-fetcher.ts",
    "checked-deps-finder": "node --import tsx/esm scripts/check-detected-packages-in-prod-dependencies.ts",
    "spellcheck": "cspell --no-progress --no-summary .",
    "format:check": "prettier --check . --log-level warn",
    "format:fix": "prettier --write . --log-level warn",
    "eslint:inspect": "eslint-config-inspector --open false",
    "lint:eslint": "eslint --cache",
    "lint:eslint:fix": "nr lint:eslint --fix",
    "lint:types": "tsc --noEmit",
    "lint:types:go": "tsgo --noEmit",
    "lint": "nr lint:types:go && nr format:check && nr lint:eslint",
    "lint:fix": "nr lint:eslint:fix && nr format:fix",
    "typegen": "node --import tsx/esm scripts/typegen.ts",
    "knip": "knip --no-progress",
    "build:code": "tsdown --clean",
    "build:code:test": "tsdown --out-dir temp/dist",
    "check:dts:no-devdeps-imports": "node --import tsx/esm scripts/check-dts-no-devdeps-imports.ts",
    "build": "nr typegen && nr build:code",
    "test:config": "node --import tsx/esm scripts/config-tester.ts",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test:common": "nr typegen && nr knip && nr spellcheck && nr test:config && nr test:vitest:cov && nr lint && nr build:code:test && nr check:dts:no-devdeps-imports",
    "test": "nr deps:check && nr test:common",
    "test:quick": "nr knip && nr spellcheck && nr test:config && nr lint && nr build:code:test",
    "lint:public-types": "attw --pack . --profile esm-only",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish",
    "prepublishOnly": "nr build && nr lint:public-types",
    "prepack": "nr build"
  },
  "overrides": {
    "eslint-plugin-jest": {
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    },
    "eslint-plugin-unused-imports": {
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    }
  },
