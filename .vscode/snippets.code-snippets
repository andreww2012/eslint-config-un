// cspell:ignore pascalcase
{
  // Place your eslint-config-un workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "eslint-config-un new config": {
    "prefix": "un-new-config",
    "body": [
      "import {ERROR, OFF, WARNING} from '../constants';",
      "import type {GetRuleOptions} from '../eslint';",
      "import {pluginsLoaders} from '../loaders';",
      "import type {Prettify} from '../types';",
      "import {doesPackageExist, fetchPackageInfo, interopDefault} from '../utils';",
      "import {type ExtraPluginsType, type UnFlatConfigEntryBase, type UnConfigFn, assignDefaults} from './index';",
      "",
      "export interface ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}EslintConfigOptions<ExtraPlugins extends ExtraPluginsType = never> extends UnFlatConfigEntryBase<ExtraPlugins, '$TM_FILENAME_BASE'> {",
      "\t/**",
      "\t * [`eslint-plugin-$TM_FILENAME_BASE`](https://npmx.dev/eslint-plugin-$TM_FILENAME_BASE) plugin",
      "\t * [shared settings](https://eslint.org/docs/latest/use/configure/configuration-files#configuring-shared-settings)",
      "\t * that will be assigned to `${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}` property",
      "\t * and applied to the resolved `files` and `ignores` of this config.",
      "\t */",
      "\tsettings?: Record<string, unknown>;",
      "}",
      "",
      "export default (async (",
      "\tcontext,",
      "\toptionsRaw,",
      ") => {",
      "const eslintPlugin${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} = await pluginsLoaders['$TM_FILENAME_BASE'](context).then(({module}) => module);",
      "",
      "// eslint-disable-next-line no-console",
      "console.log('${TM_FILENAME_BASE/(.*)/${1:/camelcase}/} rules', Object.keys(eslintPlugin${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}?.rules || {}).toSorted());",
      "",
      "// import type {${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}EslintConfigOptions} from './$TM_FILENAME_BASE';",
      "",
      "// eslint-disable-next-line jsdoc/no-bad-blocks",
      "/*",
      "",
      "/**",
      " * TODO",
      " *",
      " * 📁 Default `files`: <code>**&#47;*.</code>",
      " *",
      " * 🧩 Main plugin: [`eslint-plugin-$TM_FILENAME_BASE`](https://npmx.dev/eslint-plugin-$TM_FILENAME_BASE)",
      " * ([docs]())",
      " *",
      " * ⚙️ Sub config(s): ``, ``",
      " * @default true <=> [`foo`](https://npmx.dev/foo) package is installed",
      " * /",
      "${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}: ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}EslintConfigOptions<ExtraPlugins>;",
      "*/",
      "",
      "\tconst optionsResolved = assignDefaults(optionsRaw, {});",
      "",
      "\tconst {settings: pluginSettings} = optionsResolved;",
      "",
      "\tconst configBuilder = context.createConfigBuilder(optionsResolved, '$TM_FILENAME_BASE');",
      "",
      "// Legend:",
      "// 🟢 - in recommended",
      "",
      "\tconfigBuilder",
      "\t\t?.addConfig(['$TM_FILENAME_BASE', {",
      "\t\t\t\tincludeDefaultFilesAndIgnores: true,",
      "\t\t\t\tsettings: {",
      "\t\t\t\t\t'${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}': pluginSettings",
      "\t\t\t\t},",
      "\t\t\t}], {",
      "\t\t})",
      "\t\t// .addRule('', ERROR) /** @since  */ // 🟢",
      "\t\t.enableConfigTesterForPlugin('$TM_FILENAME_BASE')",
      "\t\t.addOverrides();",
      "",
      "\treturn {",
      "\t\tconfigs: [configBuilder],",
      "\t\toptionsResolved,",
      "\t};",
      "}) satisfies UnConfigFn<'${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}'>;",
      "",
    ],
  },
}
