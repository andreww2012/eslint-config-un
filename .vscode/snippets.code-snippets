// cspell:ignore pascalcase
{
  // Place your eslint-config-un workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "eslint-config-un new config": {
    "prefix": "un-new-config",
    "body": [
      "import {ERROR, OFF, WARNING} from '../constants';",
      "import {pluginsLoaders} from '../loaders';",
      "import {type ExtraPluginsType, type UnFlatConfigEntryBase, assignDefaults, defineUnConfig} from './index';",
      "",
      "/**",
      " * [`eslint-plugin-$TM_FILENAME_BASE`](https://npmx.dev/eslint-plugin-$TM_FILENAME_BASE) plugin",
      " * [shared settings](https://eslint.org/docs/latest/use/configure/configuration-files#configure-shared-settings)",
      " * that will be assigned to the `${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}` property of the `settings` flat config option.",
      " */",
      "export interface ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}PluginSettings {}",
      "",
      "/**",
      " * TODO",
      " *",
      " * 📁 Default `files`: <code>**&#47;*.</code>",
      " */",
      "export interface ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}EslintConfigOptions<ExtraPlugins extends ExtraPluginsType = never> extends UnFlatConfigEntryBase<ExtraPlugins, '$TM_FILENAME_BASE'> {}",
      "",
      "export default defineUnConfig<${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}EslintConfigOptions>('${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}', {",
      "\tenabledBy: {package: ''},",
      "})(async (context, optionsRaw) => {",
      "\tconst eslintPlugin${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} = await pluginsLoaders['$TM_FILENAME_BASE'](context).then(({module}) => module);",
      "",
      "\t// eslint-disable-next-line no-console",
      "\tconsole.log('${TM_FILENAME_BASE/(.*)/${1:/camelcase}/} rules', Object.keys(eslintPlugin${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}?.rules || {}).toSorted());",
      "",
      "\tconst optionsResolved = assignDefaults(optionsRaw, {});",
      "",
      "\tconst pluginSettings = context.getPluginSettings('$TM_FILENAME_BASE');",
      "",
      "\tconst configBuilder = context.createConfigBuilder(optionsResolved, '$TM_FILENAME_BASE');",
      "",
      "\t// Legend:",
      "\t// 🟢 - in recommended",
      "",
      "\tconfigBuilder",
      "\t\t?.addConfig(['$TM_FILENAME_BASE', {",
      "\t\t\t\tsettings: {",
      "\t\t\t\t\t'${TM_FILENAME_BASE/(.*)/${1:/camelcase}/}': pluginSettings,",
      "\t\t\t\t},",
      "\t\t\t}])",
      "\t\t// .addRule('', ERROR) /** @since  */ // 🟢",
      "\t\t.enableConfigTesterForPlugin('$TM_FILENAME_BASE')",
      "\t\t.addOverrides();",
      "});",
      "",
    ],
  },
}
