{
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "md",
    "css",
    "postcss",
    "svelte",
    "html",
  ],

  "[javascript][typescript][typescriptreact][vue]": {
    // Note: do NOT set `editor.formatOnSaveMode` to any value with `modifications` -
    // may incorrectly format ranges covered by `oxfmt-ignore`/`prettier-ignore` directives
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
  "js/ts.experimental.useTsgo": true,
  "cSpell.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "nr t": true,
    "nr build": true,
    "nr test:quick": true,
    "nr typegen": true,
    "nr rules-finder": true,
  },
  "git.inputValidationSubjectLength": 120,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
}
